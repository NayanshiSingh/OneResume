# Copy to backend/.env and fill in.

# Postgres from docker-compose.yml (host port 5433). Omit to use a local SQLite file.
DATABASE_URL=postgresql+psycopg://oneresume:oneresume@localhost:5433/oneresume

# AI providers. Without an LLM key, JD analysis, import, and suggestions use labelled basic mode.
# Option 1: Groq free plan (OpenAI-compatible). Get a key at https://console.groq.com/keys
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Option 2: Google Gemini (the default provider).
GEMINI_API_KEY=
PINECONE_API_KEY=

# Sessions. Set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
APP_BASE_URL=http://localhost:3000

# Private storage for generated resumes (outside any public directory).
# STORAGE_DIR=/absolute/path/to/storage
