# Copy to backend/.env and fill in.

# Postgres from docker-compose.yml (host port 5433). Omit to use a local SQLite file.
DATABASE_URL=postgresql+psycopg://oneresume:oneresume@localhost:5433/oneresume

# AI providers. Without GEMINI_API_KEY, JD analysis and rewriting use rule-based fallbacks.
GEMINI_API_KEY=
PINECONE_API_KEY=

# Sessions. Set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
APP_BASE_URL=http://localhost:3000

# Private storage for generated resumes (outside any public directory).
# STORAGE_DIR=/absolute/path/to/storage
